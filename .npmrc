# pnpm 11 defaults to "install" mode here: before running any script (e.g.
# `pnpm run build`), it re-verifies node_modules against the lockfile and,
# if it thinks anything's out of sync, spawns a NESTED `pnpm install` to fix
# it. On Hostinger's shared build hosting that nested spawn can't resolve
# `pnpm` on PATH and crashes the deploy with ENOENT — even though the real
# install (run explicitly, right before this) already completed cleanly.
# `warn` keeps the safety check (a real drift still prints a warning) without
# ever auto-spawning a subprocess. See PR #22/#23 for the failure this fixes.
verify-deps-before-run=warn

# Hostinger's build image runs pnpm under corepack (11.24 today) and pnpm
# refuses to run a project whose `packageManager` pins another version. The
# pin is still what CI and local installs use; here pnpm is told to warn
# instead of abort on the mismatch. Same major, same lockfile format.
pm-on-fail=warn
